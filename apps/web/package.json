{
  "name": "@reimagina/web",
  "version": "0.1.0",
  "description": "Reimagina read-side web app — MapLibre + vanilla TS.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run check:catalog && npm run check:ops && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:catalog": "svelte-check --tsconfig ./tsconfig.catalog.json",
    "check:ops": "svelte-check --tsconfig ./tsconfig.ops.json"
  },
  "dependencies": {
    "@lucide/svelte": "^1.57.0",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "maplibre-gl": "^5.24.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "terra-draw": "^1.37.0",
    "terra-draw-maplibre-gl-adapter": "^1.5.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.14",
    "jsdom": "^29.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
