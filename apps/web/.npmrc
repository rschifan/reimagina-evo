# Make the `engines` range in package.json a refusal rather than a warning.
#
# Without this, a Node below the floor installs cleanly and then fails far from
# the cause: undici's decompress interceptor binds `zlib.createZstdDecompress`
# at import time, so on Node 20 every test file that reaches jsdom died at
# worker spawn with "Failed to start forks worker" and no mention of Node.
# One refusal at install time is worth more than five of those.
engine-strict=true
