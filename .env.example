# reimagina environment — repo-root template for local runs.
# Copy to `.env`; never commit the filled file.
#
# There are two application-facing DSNs. The naming is deliberate so one
# tool never steps on another's transaction pool:
#
# - DATABASE_URL            — Alembic migrations, loaders, tests. Also the
#                              default for `reimagina.storage.manager`.
# - REIMAGINA_APP_DSN       — the FastAPI read-side (apps/api). Namespaced
#                              so production deploys can point it at
#                              pgbouncer without rewiring the migration
#                              runner that still wants a direct connection.
#
# In local dev they point at the same DB; in production they diverge.
# `infra/env/.env.example` shows the full compose-stack variant.

DATABASE_URL=postgresql://localhost/reimagina
TEST_DATABASE_URL=postgresql://localhost/reimagina_test
REIMAGINA_APP_DSN=postgresql://localhost/reimagina
