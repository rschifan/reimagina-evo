# reimagina environment — copy to `.env` at the repo root and fill values.
# Never commit the filled `.env`.
#
# Two onboarding paths are supported. Pick ONE block below; leave the
# other commented. The compose-stack block is the recommended default
# (`docker compose -f infra/docker/docker-compose.yml up -d` brings up
# Postgres + pgbouncer + Martin + a static PMTiles host in one shot).
#
# Naming is deliberate so one tool never steps on another's pool:
#
#   DATABASE_URL          — Alembic migrations, loaders, workers, tests,
#                           and the `reimagina.storage` default DSN.
#   REIMAGINA_APP_DSN     — FastAPI read-side (apps/api) only. Production
#                           points it at pgbouncer; migrations stay direct.
#   DATABASE_URL_DIRECT   — bypasses pgbouncer for ops that need a real
#                           server connection (Alembic, LISTEN/NOTIFY,
#                           Martin's own pool, admin tools).
#   TEST_DATABASE_URL     — pytest integration suite target.

# ── Path A: compose stack (recommended) ─────────────────────────────────────
# `cd infra/docker && docker compose up -d` brings up postgres + pgbouncer +
# martin. The variables below are also read by docker-compose.yml itself.
POSTGRES_DB=reimagina
POSTGRES_USER=reimagina_app
POSTGRES_PASSWORD=changeme_strong_password

DATABASE_URL=postgresql://reimagina_app:changeme_strong_password@localhost:5432/reimagina
REIMAGINA_APP_DSN=postgresql://reimagina_app:changeme_strong_password@localhost:5432/reimagina
DATABASE_URL_DIRECT=postgresql://reimagina_app:changeme_strong_password@localhost:5433/reimagina
TEST_DATABASE_URL=postgresql://reimagina_app:changeme_strong_password@localhost:5432/reimagina_test

# ── Path B: host-installed Postgres (alternative) ───────────────────────────
# If you run Postgres natively (Homebrew, apt) on the default 5432 with no
# auth, comment out Path A above and uncomment the block below. You'll need
# to `createdb reimagina_app reimagina_test` yourself.
#
# DATABASE_URL=postgresql://localhost/reimagina_app
# REIMAGINA_APP_DSN=postgresql://localhost/reimagina_app
# DATABASE_URL_DIRECT=postgresql://localhost/reimagina_app
# TEST_DATABASE_URL=postgresql://localhost/reimagina_test

# ── Ops plane ───────────────────────────────────────────────────────────────
# The production orchestrator is Hatchet. The API always submits asynchronously;
# a worker process registers the static DAG and executes the units.
REIMAGINA_ORCHESTRATOR=hatchet
# Obtain this from the self-hosted Hatchet dashboard. Never commit a real token.
# HATCHET_CLIENT_TOKEN=
# ⚠ HATCHET_CLIENT_HOST_PORT, not HATCHET_HOST_PORT. The SDK reads its settings
# under the prefix `HATCHET_CLIENT_` (hatchet_sdk/config.py:153), so the shorter
# spelling this file used to carry was silently ignored. Usually you need
# neither: with the variable unset the SDK takes the broadcast address out of
# the token itself, which is right whenever the token came from this engine.
# HATCHET_CLIENT_HOST_PORT=localhost:7077
# REIMAGINA_WORKER_NAME=reimagina-worker
# ⚠ Turn this on wherever the worker is supervised. It runs a small HTTP server
# inside the *action listener process* exposing /health and /metrics, and
# /health returns 503 once that process's event loop has been blocked longer
# than the threshold. That is a liveness signal nothing else can give you:
# `workers.list()` reports a registration ACTIVE as long as something
# heartbeats for it, which an orphaned or wedged listener still does.
# HATCHET_CLIENT_WORKER_HEALTHCHECK_ENABLED=true
# HATCHET_CLIENT_WORKER_HEALTHCHECK_PORT=8001
# HATCHET_CLIENT_WORKER_HEALTHCHECK_EVENT_LOOP_BLOCK_THRESHOLD_SECONDS=5
# REIMAGINA_UNIT_CONCURRENCY=2
# REIMAGINA_UNIT_TIMEOUT_MIN=120
# REIMAGINA_QUEUE_TIMEOUT_HOURS=6
# REIMAGINA_UNIT_RETRIES=2
# REIMAGINA_DEDUP_TTL_S=60
# How long a *continuous* SSE listener outage may last before the stream gives
# up and emits its error frame. Reset by any successful resubscription, so
# unrelated blips over a long run do not accumulate into a spurious failure.
# REIMAGINA_SSE_OUTAGE_DEADLINE_S=60
# ⚠ Plan retention is NOT an application setting any more. It is a scheduled
# Postgres operation — scripts/reclaim_run_plans.sql — whose horizon must exceed
# the engine's SERVER_LIMITS_DEFAULT_TENANT_RETENTION_PERIOD (720h default), or
# `runs.replay()` finds no plan. 45 days against that default.
# Pinned by digest so the qualification result names the bytes it measured.
# HATCHET_IMAGE=ghcr.io/hatchet-dev/hatchet/hatchet-lite@sha256:...
# Where the engine keeps its own state. Defaults suit a trust-auth Postgres on
# the host; set them when the engine's database needs a password or lives
# elsewhere. CI sets HATCHET_DATABASE_URL so it can run this same compose file
# rather than a second copy of the engine's configuration.
# HATCHET_PG_USER=rschifan
# HATCHET_DATABASE_URL=postgresql://user:pass@host.docker.internal:5432/hatchet?sslmode=disable
# Engine run retention. Pinned to the reclaim horizon above — change one, change
# the other; 720h here means 45 days there.
# HATCHET_RUN_RETENTION=720h
# The compose sets SERVER_GRPC_INSECURE, so the client must be told too or every
# worker dies on a TLS handshake with WRONG_VERSION_NUMBER.
# HATCHET_CLIENT_TLS_STRATEGY=none
# CLI-only: how long `indicators run --embedded` waits before giving up.
# REIMAGINA_EMBEDDED_TIMEOUT_S=3600
