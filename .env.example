# reimagina environment — copy to `.env` at the repo root and fill values.
# Never commit the filled `.env`.
#
# Two onboarding paths are supported. Pick ONE block below; leave the
# other commented. The compose-stack block is the recommended default
# (`docker compose -f infra/docker/docker-compose.yml up -d` brings up
# Postgres + pgbouncer + Martin + a static PMTiles host in one shot).
#
# Naming is deliberate so one tool never steps on another's pool:
#
#   DATABASE_URL          — Alembic migrations, loaders, workers, tests,
#                           and the `reimagina.storage` default DSN.
#   REIMAGINA_APP_DSN     — FastAPI read-side (apps/api) only. Production
#                           points it at pgbouncer; migrations stay direct.
#   DATABASE_URL_DIRECT   — bypasses pgbouncer for ops that need a real
#                           server connection (Alembic, LISTEN/NOTIFY,
#                           Martin's own pool, admin tools).
#   TEST_DATABASE_URL     — pytest integration suite target.
#   DATABASE_URL_ADMIN    — `bootstrap-db` (`make migrate`) connects here
#                           to CREATE the two databases above, since
#                           creating a database needs a connection to a
#                           different one. Needs a role that may create
#                           databases and extensions (postgis, and
#                           pgrouting for r037, neither of which is a
#                           trusted extension). Point it at any existing
#                           database on the same server — `postgres` is
#                           the conventional choice.

# ── Path A: compose stack (recommended) ─────────────────────────────────────
# `cd infra/docker && docker compose up -d` brings up postgres + pgbouncer +
# martin. The variables below are also read by docker-compose.yml itself.
#
# ⚠ Which port a DSN uses is not cosmetic in this stack:
#
#   localhost:5432 — PgBouncer, transaction pool mode. It is configured with
#                    exactly one database, POSTGRES_DB. Asking it for any
#                    other name (`postgres`, `reimagina_test`) fails to
#                    connect at all, and it cannot carry CREATE DATABASE,
#                    LISTEN/NOTIFY, session GUCs set with SET (as opposed to
#                    SET LOCAL), or a long-running migration lock.
#   localhost:5433 — PostgreSQL itself, published for exactly those jobs.
#
# So only the app's own read-side goes through the pooler. Migrations,
# bootstrap, the test suite and the ops plane connect to the server.
POSTGRES_DB=reimagina
POSTGRES_USER=reimagina_app
POSTGRES_PASSWORD=changeme_strong_password

# Alembic, loaders, the CLI, `reimagina.storage`. Direct: `make migrate` runs
# DDL and CREATE EXTENSION through this, which a transaction-mode pooler is
# the wrong place for — the compose file's own quick-start says as much.
DATABASE_URL=postgresql://reimagina_app:changeme_strong_password@localhost:5433/reimagina
# FastAPI read-side only. This one is pooled, which is the point of the pooler:
# many short, read-only, SET LOCAL-only request handlers over few backends.
REIMAGINA_APP_DSN=postgresql://reimagina_app:changeme_strong_password@localhost:5432/reimagina
# DBOS checkpoints + SSE. Direct is mandatory, not preferred: LISTEN/NOTIFY is
# a session-scoped protocol and transaction pooling hands the session away.
DATABASE_URL_DIRECT=postgresql://reimagina_app:changeme_strong_password@localhost:5433/reimagina
# `reimagina_test` is not in PgBouncer's database list, and the suite creates
# and drops schemas. Direct.
TEST_DATABASE_URL=postgresql://reimagina_app:changeme_strong_password@localhost:5433/reimagina_test
# CREATE DATABASE cannot run inside a transaction block, and `postgres` is not
# in PgBouncer's database list either. Direct, twice over.
DATABASE_URL_ADMIN=postgresql://reimagina_app:changeme_strong_password@localhost:5433/postgres

# ── Path B: host-installed Postgres (alternative) ───────────────────────────
# If you run Postgres natively (Homebrew, apt) on the default 5432 with no
# auth, comment out Path A above and uncomment the block below. You'll need
# to `createdb reimagina_app reimagina_test` yourself.
#
# DATABASE_URL=postgresql://localhost/reimagina_app
# REIMAGINA_APP_DSN=postgresql://localhost/reimagina_app
# DATABASE_URL_DIRECT=postgresql://localhost/reimagina_app
# TEST_DATABASE_URL=postgresql://localhost/reimagina_test
# DATABASE_URL_ADMIN=postgresql://localhost/postgres

# ── Ops plane ───────────────────────────────────────────────────────────────
# The ops-plane is DBOS: durable execution as a library. Checkpoints live in
# this same database under the `dbos` schema, so there is no engine to deploy
# and no second database to operate.
#
# DATABASE_URL_DIRECT is required by it and is not optional: checkpoints and
# progress streams both need a real server connection, and DBOS falls back to a
# local SQLite file when no database URL is set — a missing value produces a
# working process with private, unrecoverable checkpoints rather than an error.

# Identifies this process to crash recovery, which reclaims only the work
# recorded against this exact id. It must be BOTH stable across restarts (or a
# restarted process reclaims nothing) and unique between concurrent processes
# (or one reclaims work another is still running — a double execution).
#
# Unset, it derives <hostname>:<role>, which is right for at most one process
# per role per host. Running more than one API or more than one worker on a
# host? Set this per replica — a StatefulSet pod name or a systemd instance
# name is the right shape. A warning naming the derived id is logged at launch.
# REIMAGINA_EXECUTOR_ID=worker-2

# Distinguishes co-located processes when the id is derived. `python -m
# apps.worker` sets this to "worker" itself; everything else defaults to "app".
# REIMAGINA_EXECUTOR_ROLE=app

# How many indicator units this process runs at once. A property of the DBOS
# queue, not of the worker command.
# REIMAGINA_UNIT_CONCURRENCY=2

# ── Reclaiming a dead executor's work ────────────────────────────────────────
# `DBOS.launch()` recovers an executor's own interrupted workflows, which
# covers a restart. It does not cover a death: a destroyed host leaves PENDING
# workflows recorded against an id nothing will ever claim, and the run never
# reaches a terminal state. A live peer sweeps those, gated on liveness.

# How often each process publishes its liveness row.
# REIMAGINA_EXECUTOR_HEARTBEAT_S=30

# How silent an executor must be before a peer presumes it dead and
# re-enqueues its work.
#
# ⚠ Raise it, never lower it, and never raise the beat interval without
# raising this with it — the startup check refuses a value below 4x the beat.
# The asymmetry is the whole argument: reclaiming a dead executor late costs
# latency, reclaiming a live one costs a second concurrent execution of the
# same indicator.
# REIMAGINA_EXECUTOR_STALE_S=300

# How often the worker looks for dead executors. Defaults to half the
# staleness window, floor 60s.
# REIMAGINA_RECLAIM_SWEEP_S=150

# Turn the sweep off. The worker logs a warning when you do, because the
# consequence is that a dead executor's runs stay in progress forever until a
# process with its id restarts.
# REIMAGINA_RECLAIM_ENABLED=0

# Pins the application version that gates recovery. Unset, DBOS derives it from
# the registered workflow source, so any edit strands in-flight runs as
# unrecoverable. Pinned, they become recoverable onto possibly-incompatible
# code — which is why deploys are blue-green, keeping old-version processes
# alive to drain. Set it deliberately or not at all.
# REIMAGINA_APP_VERSION=2026-07-28.1

# Which orchestrator `factory.get_orchestrator()` builds when a caller does not
# name one. `dbos` is the only deployable value and the default.
#
# `sync` (in-process, no ops-plane) is a real mode but is rejected here: it
# keeps run state in memory per orchestrator instance, and the factory builds a
# fresh instance per call — so POST would write to Postgres while GET read an
# empty dict. Callers that want it name it explicitly.
# REIMAGINA_ORCHESTRATOR=dbos
