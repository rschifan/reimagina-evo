# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
/env/
.env/
pip-wheel-metadata/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checkers
.mypy_cache/
.pytype/
.pyre/

# ── Local data ───────────────────────────────────────────────────────────────
# Anything under data/ is local cache or bootstrap output — never tracked.
# Bootstrap procedure to re-fetch is documented in docs/BOOTSTRAP.md.
data/

# ── Environment / secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
# Timestamped copies made before editing .env. They carry the same DSNs as the
# real file and are not covered by the patterns above, so they would otherwise
# be offered up as untracked files at the next `git add`.
.env.backup-*
!.env.example

# ── Node / TypeScript ────────────────────────────────────────────────────────
node_modules/
.npm/
*.tsbuildinfo
.next/
.nuxt/
.output/
apps/web/.next/
apps/web/dist/

# ── IDE / editors ────────────────────────────────────────────────────────────
.vscode/
.idea/
.obsidian/
*.swp
*.swo
*~
.project
.classpath

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ── Docker volumes ───────────────────────────────────────────────────────────
infra/docker/volumes/

# ── Local tooling installs ───────────────────────────────────────────────────
.tools/

# ── Dated backup snapshots ───────────────────────────────────────────────────
[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# ── Agent instruction files (local only, not published) ─────────────────────
CLAUDE.md
.claude/*
# ...except the project settings that enforce commit authorship, which have
# to travel with the repository to be worth anything. Note `.claude/*` rather
# than `.claude/`: git does not descend into an excluded *directory*, so a
# negation for a file inside one never matches and the file stays silently
# untracked — which is exactly how this was missed the first time.
!.claude/settings.json

# ── Misc ─────────────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.orig
.hypothesis/

# Workload-suite reports (tests/workloads) — regenerated, never reviewed.
artifacts/

# osmnx's Overpass response cache, written to ./cache by default. Worth keeping
# locally — a repeat fetch of the same polygon drops from ~125 s to ~0 s — but
# it is derived data; the graph that matters lives in Postgres.
cache/

# Ad-hoc table dumps taken before a destructive migration (the AGEB-grain
# retirement left 6.8 MB of them tracked under a dotted directory, where a
# review diff never showed them). Derived data: reproducible from the pipeline
# against the INEGI sources, and the old rows stay in git history regardless.
.*-backup/
