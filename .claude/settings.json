{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/require-rossano-identity.sh\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking commit identity"
          }
        ]
      }
    ]
  }
}
