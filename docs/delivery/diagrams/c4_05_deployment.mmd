---
title: "Figure 8 — Deployment: the reference single-host installation"
config:
  flowchart:
    wrappingWidth: 520
    nodeSpacing: 30
    rankSpacing: 45
  themeCSS: ".flowchartTitleText{font-size:30px;font-weight:600;fill:#16181d}"
---
flowchart TB
  subgraph browser["Web browser [Deployment node]"]
    webi["Web application<br/>[four HTML pages<br/>and ES modules]"]
  end

  subgraph host["Host [Deployment node: macOS or Linux]"]
    vite["Web dev server<br/>[Vite 8, :5173]<br/>Serves the pages,<br/>proxies /api"]
    apii["API application<br/>[uvicorn, :8001]<br/>Pool of 16<br/>connections"]
    workeri["Recomputation<br/>worker<br/>[python -m<br/>apps.worker]"]
    clii["Operator CLI<br/>[Typer,<br/>on demand]"]
  end

  subgraph infra["Docker Compose [Deployment node]"]
    pool["Pooler<br/>[pgbouncer 1.26.1,<br/>:5432]<br/>Transaction mode"]
    dbi[("Database<br/>[PostgreSQL 16,<br/>PostGIS 3.4,<br/>pgRouting 3.6.1,<br/>:5433]")]
    martini["Tile server<br/>[Martin 0.14,<br/>:3000]"]
    static["Snapshot host<br/>[nginx 1.27,<br/>:3001]<br/>PMTiles for<br/>GIS clients"]
  end

  webi -->|"[HTTP]"| vite
  vite -->|"/api<br/>[HTTP]"| apii
  webi -.->|"MVT [HTTP],<br/>when chosen"| martini
  apii -->|"Pooled<br/>[SQL]"| pool
  pool -->|"[SQL]"| dbi
  apii -->|"DBOS client<br/>[SQL direct,<br/>LISTEN/<br/>NOTIFY]"| dbi
  workeri -->|"[SQL direct]"| dbi
  clii -->|"[SQL]"| dbi
  martini -->|"[SQL direct]"| dbi

  classDef container fill:#438dd5,stroke:#2e6295,color:#fff
  class webi,vite,apii,workeri,clii,pool,dbi,martini,static container
