    ind["Indicator computation<br/>[Component: indicators]<br/>Spatial measures in SQL;<br/>Python kernels in a<br/>Hamilton dataflow,<br/>Pandera output checks"]
    scen["Scenario resolution<br/>[Component: scenarios]<br/>Override, then<br/>observation, then base"]
    life["Run bookkeeping<br/>[Component: jobs]<br/>A job_run record<br/>per executed unit"]
  end

  db[("Database<br/>[Container: PostgreSQL 16,<br/>PostGIS, pgRouting]")]

