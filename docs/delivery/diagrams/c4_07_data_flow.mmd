---
title: "Figure 6 — End-to-end data flow, from the data publishers to the web pages"
config:
  flowchart:
    wrappingWidth: 520
    nodeSpacing: 30
    rankSpacing: 45
  themeCSS: ".flowchartTitleText{font-size:30px;font-weight:600;fill:#16181d}"
---
flowchart TB
  subgraph load["1 · Load: operator CLI, on demand"]
    direction LR
    src["Publishers<br/>[External]<br/>Overture, OSM,<br/>WorldPop,<br/>INEGI, CDMX;<br/>lake mirror"]
    pipe["Ingestion<br/>pipelines<br/>overture (3),<br/>cdmx, inegi (2),<br/>points,<br/>network, raster"]
    medal[("bronze,<br/>silver [data/]<br/>GeoParquet,<br/>COG")]
    cur[("curated_geo<br/>feature,<br/>observation,<br/>road graph,<br/>raster_layer")]
    derive["Derivations<br/>AOIs, overlaps,<br/>zonal stats,<br/>rollups,<br/>summaries"]
    src -->|"Fetch"| pipe
    pipe -->|"Land"| medal
    medal -->|"Load"| cur
    cur <-->|"Read,<br/>write"| derive
  end

  subgraph compute["2 · Compute: runs"]
    direction LR
    submit["Submission<br/>API: POST /jobs,<br/>scenario recompute;<br/>CLI: indicators,<br/>scenario recompute"]
    queue[("DBOS queues<br/>runs, units<br/>[dbos,<br/>jobs_runtime]")]
    worker["Worker<br/>indicator units<br/>in dependency<br/>waves"]
    result[("indicator_result<br/>[curated_geo]<br/>baseline and<br/>scenario rows")]
    submit -->|"Enqueue"| queue
    queue -->|"Dequeue"| worker
    worker -->|"Write"| result
  end

  subgraph serve["3 · Serve"]
    direction LR
    serving[("serving_geo<br/>views over 1 and 2;<br/>three tile<br/>functions")]
    api["API<br/>JSON, downloads,<br/>SSE, MVT; COG<br/>from silver (/cog)"]
    martin["Martin<br/>MVT"]
    pages["Web pages<br/>map, scenarios,<br/>catalogue, runs"]
    pmt["PMTiles snapshot<br/>CLI tiles export,<br/>nginx :3001,<br/>GIS clients"]
    serving -->|"[SQL]"| api
    serving -->|"[SQL]"| martin
    api -->|"[HTTP]"| pages
    martin -.->|"[HTTP]"| pages
    serving -->|"Export"| pmt
  end

  load -->|"Inputs:<br/>features,<br/>observations,<br/>overrides"| compute
  compute -->|"Values"| serve

  classDef external fill:#8a8a8a,stroke:#6b6b6b,color:#fff
  classDef container fill:#438dd5,stroke:#2e6295,color:#fff
  class src external
  class pipe,derive,submit,worker,api,martin,pages,pmt,medal,cur,queue,result,serving container
